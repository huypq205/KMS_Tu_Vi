# Copy file này thành .env rồi điền key thật

# --- Cơ chế nạp cấu hình môi trường ---
# Mặc định (0): file .env ghi đè trực tiếp lên os.environ, tránh biến hệ thống Windows/shell đè lên .env.
# Đặt = 1 nếu muốn giữ nguyên biến môi trường hệ thống (dùng os.environ.setdefault).
KMS_PRESERVE_SYSTEM_ENV=0

# --- Lựa chọn Provider cho AI ---
# Provider cho chatbot tra cứu KMS: auto | gemini | groq | mock (mặc định: auto: Gemini chính -> Groq dự phòng)
KMS_LLM_PROVIDER=auto
# Provider cho Horoscope AI Interpreter: auto | gemini | groq | mock (mặc định: auto)
# auto: thử lần lượt theo chuỗi fallback (Gemini chính -> Groq dự phòng -> Mock)
KMS_HOROSCOPE_PROVIDER=auto

# --- Cấu hình Google Gemini API (Provider CHÍNH) ---
GEMINI_API_KEY=your_gemini_api_key_here
KMS_GEMINI_MODEL=gemini-3.8-flash
# Model chính cho horoscope; khi quá tải sẽ chuyển sang KMS_HOROSCOPE_FALLBACK_MODELS.
KMS_HOROSCOPE_MODEL=gemini-3.5-flash-lite
# Model dự phòng khi model chính quá tải (mỗi model có quota free tier riêng).
KMS_HOROSCOPE_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
KMS_HOROSCOPE_TIMEOUT_SECONDS=45
# Gemini 3.x tính cả token thinking vào hạn mức; 2500 dễ làm bài bị cắt.
KMS_HOROSCOPE_MAX_TOKENS=8192
KMS_HOROSCOPE_MAX_TOKENS_GIAI_THICH=3000
KMS_HOROSCOPE_MAX_TOKENS_CHUYEN_SAU=8192

# --- Cấu hình Groq API (Provider DỰ PHÒNG) ---
# Miễn phí, tốc độ cao, dùng làm phương án dự phòng khi Gemini hết quota hoặc lỗi
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# --- Cấu hình DeepSeek API (Đã loại bỏ - giữ lại cấu hình nếu cần tham khảo) ---
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# --- Cấu hình Tri thức & Nghiệp vụ Tử Vi ---
# Bảng Tứ Hóa cho lá số gốc và lưu niên: lasotuvi (mặc định) | hung_ngm_reference.
# Bảng tham khảo chưa đối chiếu sách KMS; khởi động lại backend sau khi đổi .env.
KMS_TU_HOA_TABLE=lasotuvi
# Cho phép lớp seed tham khảo trong hồ sơ sao khi người xem chủ động bật.
KMS_STAR_SEEDS_ENABLED=1
# Tham khảo ý nghĩa sao từ skill local cho hồ sơ sao (khi bật tham khảo) và AI.
KMS_STAR_MEANINGS_ENABLED=1
# Rỗng = skills/tu-vi-dau-so-main/tu-vi-dau-so/skills/tu-vi-dau-so/references/star_meanings.md
KMS_STAR_MEANINGS_PATH=

# --- Bảo mật API (tuỳ chọn, chạy trên Render) ---
# Khi đặt KMS_API_KEY: mọi /api/v1/* (trừ /health) bắt buộc header X-API-Key.
# Frontend (Streamlit) cũng đọc biến này và gửi kèm. Rỗng (mặc định) = API mở.
KMS_API_KEY=
# Giới hạn số request/phút cho /api/v1/horoscope* (0 = tắt). Mặc định 10.
KMS_RATE_LIMIT_PER_MIN=10
# Danh sách origin CORS (phân tách bằng dấu phẩy). Production: thêm domain Streamlit Cloud.
KMS_CORS_ORIGINS=http://localhost:8501,http://localhost:8502

# --- Frontend (Streamlit) ---
# Buộc app trỏ vào backend cụ thể (không cần thiết khi chạy backend local 127.0.0.1:8000).
KMS_API_BASE=
